# URL del Backend API Principal (local o Render)
VITE_API_URL=http://localhost:4000

# URL del Backend Realtime Socket.IO (local o Render)
VITE_REALTIME_URL=http://localhost:4001

# Configuración pública del cliente Firebase Authentication (Sprint 1 - TS-01 / US-01 / US-02 / US-03)
VITE_FIREBASE_API_KEY=tu_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-firebase-id

# Correo de la cuenta que puede ver la pantalla técnica /firestore
VITE_ADMIN_EMAIL=tu_correo@ejemplo.com
VITE_FIREBASE_APP_ID=tu_firebase_app_id

